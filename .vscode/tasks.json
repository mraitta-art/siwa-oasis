{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Deploy to Vercel (one click)",
			"type": "shell",
			"command": "node",
			"args": [
				"scripts/vercel-deploy.cjs"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "Budget-aware deploy: gates, commit, push to the Vercel-watched repo, wait for the build, then verify production.",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "Build SIWA production release",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Commit staged changes and push",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\scripts\\commit-push.ps1",
				"-Message",
				"${input:commitMessage}"
			],
			"detail": "Commits only staged changes, then pushes the current branch.",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		}
	],
	"inputs": [
		{
			"id": "commitMessage",
			"type": "promptString",
			"description": "Commit message",
			"password": false
		}
	]
}