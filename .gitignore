# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.production
.env.vercel
.env.deploy
.env.railway
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# deployment bundles
/deploy_bundle
/deploy_bundle_cpanel
/siwa-cpanel-release
/siwa-cpanel-release.zip
*.zip

# sync tracking
.last-sync-hashes.json
.sync-manifest.json

# temporary logs
server_log.txt
/scratch

# auto-sync system logs (contain timestamps/commit data, not needed in repo)
sync.log
sync-git.log
*.log

# security — never commit these
secrets.json
*.key
*.pem
credentials.json
service-account.json

# database backups (can be large and contain sensitive data)
# A stray dump anywhere stays ignored, but every file inside migrations/ is
# source: it is the only record of how the live schema got its shape. Listing
# migrations one by one meant a new schema change could be silently untracked.
*.sql
!migrations/*.sql
database_backups/
*.dump
# JSON dumps of live tables: vendor contact data, never a source file
backups/*.json
.env*
# local Vercel CLI helper scripts
/.vercel-tmp/
