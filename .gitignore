# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.production
.env.vercel
.env.deploy
.env.railway
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# deployment bundles
/deploy_bundle
/deploy_bundle_cpanel
/siwa-cpanel-release
/siwa-cpanel-release.zip
*.zip

# sync tracking
.last-sync-hashes.json
.sync-manifest.json

# temporary logs
server_log.txt
/scratch

# auto-sync system logs (contain timestamps/commit data, not needed in repo)
sync.log
sync-git.log
*.log

# security — never commit these
secrets.json
*.key
*.pem
credentials.json
service-account.json

# database backups (can be large and contain sensitive data)
*.sql
!migrations/037_dynamic_transportation_services.sql
!migrations/041_minisite_vendor_handoffs.sql
!migrations/042_crm_contact_groups.sql
!migrations/043_vendor_profile_contact_and_approval.sql
!migrations/044_vendor_service_levels.sql
!migrations/045_outreach_templates.sql
!migrations/046_businesses_publish_flags.sql
!migrations/047_vendor_crm_tables.sql
!migrations/20261031_section_name_ar.sql
!migrations/20261102_unit_offer_terms.sql
database_backups/
*.dump
# JSON dumps of live tables: vendor contact data, never a source file
backups/*.json
.env*
# local Vercel CLI helper scripts
/.vercel-tmp/
