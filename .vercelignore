# Large deployment artifacts - exclude from Vercel upload
*.zip
*.tar.gz
*.rar

# Deploy bundles
deploy_bundle/
deploy_bundle_cpanel/
siwa-cpanel-release/

# Local scripts and dev tools
scripts/
scratch/
data/
migrations/

# Local DB files
*.sql
data_dump.sql
missing_data*.sql
missing_data_utf8.sql
TIDB_SYNC.sql
master-schema.sql
schema.sql

# Python deploy scripts
*.py
auto_deploy_now.py
deploy.py
upload_ftp.py

# Shell/batch deploy scripts
*.sh
*.bat
import.bat

# Test files
*.test.js
test-*.js
check-*.js
verify-*.js
run-migration.js
fix-passwords.js
migrate*.mjs
insert-*.mjs

# Log files
*.log
jana_errors.log
server_log.txt
ts_errors*.txt

# Local env files: Vercel CLI uploads what this file allows, and .gitignore is
# ignored once .vercelignore exists, so secrets must be excluded here explicitly.
.env
.env.*
!.env.example

# Node
node_modules/

# Next.js build output (Vercel builds its own)
.next/

# Docs (large markdown files not needed at runtime)
*.md

# Misc dev files
tsconfig.tsbuildinfo
.last-sync-hashes.json
deployment-config.json
