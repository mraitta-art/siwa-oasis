# SIWA OASIS — Environment Config
# ================================

# MySQL Database (cPanel)
DB_HOST=localhost
DB_PORT=3306
DB_USER=siwatoday_admin
DB_PASSWORD=your_secure_password
DB_NAME=siwatoday_main

# Auth (Generate a random 64-char hex string for production)
JWT_SECRET=change_me_to_a_64_character_random_hex_string_in_production_now
SESSION_COOKIE_NAME=siwa_session
# Optional: set this only when sharing sessions across subdomains, e.g. .siwify.com
COOKIE_DOMAIN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

