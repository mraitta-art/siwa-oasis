'use client';

import React, { useState } from 'react';

interface MapNode {
  id: string;
  name: string;
  category: string;
  x: number;
  y: number;
  description: string;
  statLabel: string;
  statValue: string;
  link: string;
  icon: string;
}

interface InteractiveEcosystemMapProps {
  title?: string;
  subtitle?: string;
  locationName?: string;
  locationCategory?: string;
  locationDescription?: string;
  locationLink?: string;
  businessOnly?: boolean;
}

export default function InteractiveEcosystemMap({
  title,
  subtitle,
  locationName,
  locationCategory,
  locationDescription,
  locationLink,
  businessOnly,
}: InteractiveEcosystemMapProps) {
  const [activeNode, setActiveNode] = useState<MapNode | null>(null);

  const businessNode: MapNode | null = locationName ? {
    id: 'business_location',
    name: locationName,
    category: locationCategory || 'Business Location',
    x: 600,
    y: 280,
    description: locationDescription || 'This location is registered for the featured business.',
    statLabel: 'LOCATION TYPE',
    statValue: locationCategory || 'Verified',
    link: locationLink || '',
    icon: 'fa-map-marker-alt',
  } : null;

  const nodes: MapNode[] = [
    {
      id: 'shali',
      name: 'Shali Fortress',
      category: 'Heritage & Culture',
      x: 480,
      y: 280,
      description: 'The ancient 13th-century clay fortress built from Kershef (salt bricks).',
      statLabel: 'CONSTRUCTION ERA',
      statValue: '1200s AD',
      link: '/search/vibe?q=shali',
      icon: 'fa-landmark'
    },
    {
      id: 'salt-lakes',
      name: 'Saline Therapeutic Lakes',
      category: 'Wellness & Healing',
      x: 720,
      y: 190,
      description: 'Extremely high-density hyper-salinity salt pools.',
      statLabel: 'SALINITY DENSITY',
      statValue: '95% Pure Salt',
      link: '/search/vibe?q=salt',
      icon: 'fa-water'
    },
    {
      id: 'cleopatra',
      name: 'Cleopatra\'s Pool',
      category: 'Healing Springs',
      x: 580,
      y: 350,
      description: 'The legendary natural thermal spring pool.',
      statLabel: 'WATER TEMP',
      statValue: '29°C Stable',
      link: '/search/vibe?q=cleopatra',
      icon: 'fa-swimming-pool'
    },
    {
      id: 'amellal',
      name: 'Adrere Amellal Eco-Retreat',
      category: 'Eco-Luxury Lodging',
      x: 230,
      y: 240,
      description: 'The world-famous eco-lodge built into the white mountain.',
      statLabel: 'CARBON EMISSIONS',
      statValue: 'Net Zero',
      link: '/search/vibe?q=lodge',
      icon: 'fa-leaf'
    },
    {
      id: 'orchards',
      name: 'Organic Date & Olive Orchards',
      category: 'Agriculture & Food',
      x: 350,
      y: 380,
      description: 'Generations of family-owned orchards harvesting organic Siwan dates.',
      statLabel: 'ORGANIC STATUS',
      statValue: '100% Certified',
      link: '/search/vibe?q=date',
      icon: 'fa-seedling'
    }
  ];

  const displayNodes: MapNode[] = businessNode
    ? businessOnly
      ? [businessNode]
      : [businessNode, ...nodes.filter((n) => n.id !== businessNode.id)]
    : nodes;

  const renderNodes = displayNodes.map((n) => {
    const isActive = activeNode?.id === n.id;
    return (
      <g
        key={n.id}
        transform={`translate(${n.x}, ${n.y})`}
        style={{ cursor: 'pointer' }}
        onMouseOver={() => setActiveNode(n)}
        onClick={() => setActiveNode(n)}
      >
        <circle r={isActive ? 24 : 14} fill="rgba(255, 183, 0, 0.08)" style={{ transition: 'all 0.3s' }} />
        <circle r={isActive ? 16 : 9} fill="rgba(255, 183, 0, 0.15)" style={{ transition: 'all 0.3s' }} />
        <circle r="5" fill="var(--gold)" />
        <text
          y="-25"
          textAnchor="middle"
          fill={isActive ? 'var(--text)' : 'var(--text-light)'}
          style={{
            fontSize: '11px',
            fontWeight: 900,
            letterSpacing: '1px',
            textTransform: 'uppercase',
            transition: 'fill 0.3s'
          }}
        >
          {n.name}
        </text>
      </g>
    );
  });

  return (
    <div style={{ padding: '6rem 0', background: 'var(--bg)', borderTop: '1px solid var(--border-light)' }}>
      <div style={{ maxWidth: '1200px', margin: '0 auto', padding: '0 1.5rem' }}>
        <div style={{ textAlign: 'center', marginBottom: '3rem' }}>
          <span style={{ color: 'var(--gold)', fontWeight: 900, letterSpacing: '4px', fontSize: '0.75rem', textTransform: 'uppercase', display: 'block', marginBottom: '1rem' }}>
            {subtitle || 'GEOGRAPHIC LAYOUT'}
          </span>
          <h2 style={{ color: 'var(--text)', fontSize: 'clamp(2rem, 3.5vw, 2.5rem)', fontWeight: 900, margin: 0 }}>
            {title || 'Interactive Ecosystem Map'}
          </h2>
        </div>

        <div style={{ background: 'var(--bg-alt)', borderRadius: '32px', border: '1px solid var(--border)', padding: '1rem', boxShadow: 'var(--shadow-lg)' }}>
          <svg viewBox="0 0 1000 500" style={{ width: '100%', height: 'auto', background: 'var(--bg-alt)', borderRadius: '24px' }}>
            <defs>
              <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                <path d="M 40 0 L 0 0 0 40" fill="none" stroke="var(--border)" strokeWidth="0.5" />
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#grid)" />
            {renderNodes}
          </svg>
        </div>

        {activeNode && (
          <div style={{ marginTop: '1.5rem', background: 'var(--card)', border: '1px solid var(--border)', borderRadius: '24px', padding: '1.5rem' }}>
            <div style={{ color: 'var(--gold)', fontSize: '0.75rem', fontWeight: 900, letterSpacing: '2px', textTransform: 'uppercase' }}>{activeNode.category}</div>
            <h3 style={{ color: 'var(--text)', margin: '0.2rem 0 0.4rem', fontWeight: 900 }}>{activeNode.name}</h3>
            <p style={{ color: 'var(--text-muted)', margin: 0, lineHeight: 1.6 }}>{activeNode.description}</p>
          </div>
        )}
      </div>
    </div>
  );
}
